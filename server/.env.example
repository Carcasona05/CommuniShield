PORT=3000

SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

SMTP_HOST=smtp.gmail.com
SMTP_PORT=your_PORT
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_password
EMAIL_FROM="CommuniShield <your_email@gmail.com>"

# Required for password reset and login-device verification.
UPSTASH_REDIS_REST_URL=your_upstash_rest_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token
# Optional dedicated secret (32+ characters). Defaults to a domain-separated
# key derived from SUPABASE_SERVICE_ROLE_KEY. Rotating either invalidates trust.
# LOGIN_VERIFICATION_SECRET=generate_a_random_secret_of_at_least_32_characters

GEMINI_API_KEY=your_gemini_api_key

# Optional: required only when enhanced Expo push security is enabled.
# EXPO_ACCESS_TOKEN=your_server_only_expo_access_token

# Optional: override local ONNX directory (defaults to server/models, then datasets/models)
# SENTIMENT_MODEL_DIR=models
